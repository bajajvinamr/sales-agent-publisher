# Caddy reverse-proxy config — Phase 5 ingress (PRODUCTION MODE).
#
# Replaces the cloudflared tunnel as the public ingress for sales.telligences.com.
# Architecture: User → Cloudflare proxy edge → droplet:443 (Caddy) → app:3000
#
# TLS: Cloudflare Origin Certificate, mounted from /etc/caddy on the droplet.
#   - Issued by Cloudflare Origin CA (NOT a public CA)
#   - Valid 15 years; renewal is manual via CF dashboard
#   - Cloudflare's Full (strict) SSL mode validates this cert on its CA
#
# Ingress traffic flow:
#   1. User → Cloudflare anycast IP (resolved from DNS)
#   2. Cloudflare proxy → droplet 443 over TLS (validates origin cert)
#   3. Caddy terminates TLS, reverse-proxies to app:3000 over docker-internal
#   4. Real client IP surfaced via cf-connecting-ip header (already trusted —
#      Cloudflare strips this header from incoming requests, sets it itself)
#
# Why Caddy: 10-line config vs nginx 60+, ~15 MB resident, no ACME complexity
# since we use a long-lived CF Origin Cert.
#
# See docs/proposals/ingress-hardening.md for the full migration rationale.

{
	admin off
}

sales.telligences.com {
	tls /etc/caddy/origin-cert.pem /etc/caddy/origin-key.pem

	reverse_proxy app:3000 {
		# cf-connecting-ip is the real client IP set by Cloudflare's edge.
		# Trustworthy because traffic only reaches us via Cloudflare proxy
		# (orange-cloud) — the droplet's port 443 should reject any traffic
		# that didn't come through CF (future hardening: CF IP allowlist on
		# UFW). Until then, the header is the best client-IP source.
		header_up X-Real-IP {http.request.header.cf-connecting-ip}
		header_up X-Forwarded-For {http.request.header.cf-connecting-ip}
	}

	# Security headers — match the existing middleware-applied set on the
	# Next.js app. Caddy applies these to every response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
		level INFO
	}
}
